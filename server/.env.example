# =================================================================
# FindIt Backend Environment Configuration Example
# Copy this file to .env and provide your specific credentials.
# Do NOT commit your production secrets or .env file to version control.
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_strong_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Frontend Client URL & CORS Configuration
# Set CLIENT_URL to your production frontend URL (e.g., https://findit.yourdomain.com)
CLIENT_URL=http://localhost:5173

# Optional: Comma-separated list of additional allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Service (Nodemailer / SMTP) for Password Reset Notifications
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_smtp_app_password

# =================================================================
# IMAGE STORAGE NOTICE (DEPLOYMENT REQUIREMENT)
# =================================================================
# FindIt currently stores uploaded images locally in server/uploads/
# and serves them statically via the /uploads route.
#
# IMPORTANT DEPLOYMENT NOTE:
# In cloud hosting and containerized environments (Render, Railway,
# Heroku, Docker, AWS ECS, Kubernetes), the local filesystem is EPHEMERAL.
# Containers restarted or redeployed will wipe uploaded files unless:
#
# 1. A persistent volume mount is configured for the 'server/uploads/' directory, OR
# 2. Storage is migrated to a cloud object store (AWS S3, Cloudinary, or Google Cloud Storage).
#
# For production deployments, attach a persistent disk volume to server/uploads.
# =================================================================
